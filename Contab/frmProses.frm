On Error GoTo msgError
Dim fso As New FileSystemObject, ts As TextStream
Dim RowLine, RowGrid As Integer
Dim RowValue, NewLine, ContabUser, ContabOPCAO, Texto As String
  
LG = EscreveLOG(1, "OpenContabEXC( - Inicio processo")

flFileName = Programpath & "\" & flFileName

If fso.FileExists(flFileName) = True Then
  
  NewLine = Chr$(13) & Chr$(10)
  OpenContabEXC = Empty
  If Dir(flFileName, vbNormal) = "" Then
    LG = EscreveLOG(9, "OpenContabEXC - Erro na abertura ficheiro " & flFileName)
    MsgBox msgMessageError, msgStyleError, msgTitleError

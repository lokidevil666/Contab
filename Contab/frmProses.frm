DevSQLAtr = ""

If Left(Trim(SQLvlr), 1) = "=" Then
  If Left(Combo8, 12) = "Primavera GM" Then
    Select Case ToTXT2
    Case "1"
      DevSQLAtr = DevBDData(Grid31, Mid(Trim(SQLvlr), 2, 20), 1)
    Case "2"
      DevSQLAtr = " " & DevBDData(Trim(Grid31), Mid(Trim(SQLvlr), 2, 20), 1)
    Case "3", "4", "5", "6", "7"
      DevSQLAtr = ""
    End Select
  Else
    DevSQLAtr = DevBDData(Trim(Grid31), Mid(Trim(SQLvlr), 2, 20), 1)
  End If
Else
  If Left(Combo8, 12) = "Primavera GM" Then
    Select Case ToTXT2
    Case "1"
      DevSQLAtr = Trim(SQLvlr)
    Case "2"
      DevSQLAtr = " " & Trim(SQLvlr)
    Case "3", "4", "5", "6", "7"
      DevSQLAtr = ""
    End Select
  Else
    DevSQLAtr = Trim(SQLvlr)
  End If
End If
                
               
GoTo fim


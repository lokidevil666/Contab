      Grid3.TextMatrix(num, 13) = XUCodBanco(Trim(rs!Conta))
      Grid3.TextMatrix(num, 8) = Abs(rs!Montante)
      If (rs!Montante < 0) Then
        Grid3.TextMatrix(num, 9) = "-"
      Else
        Grid3.TextMatrix(num, 9) = "+"
      End If
      If IsNull(Trim(rs!Divisa)) Then
        Grid3.TextMatrix(num, 10) = ""
      Else
        Grid3.TextMatrix(num, 10) = Trim(rs!Divisa)
      End If
      If IsNull(Trim(rs!zu_01)) Then
        Grid3.TextMatrix(num, 11) = ""
      Else
        Grid3.TextMatrix(num, 11) = Trim(rs!zu_01)
      End If
      Grid3.TextMatrix(num, 12) = "R" & rs!recid
      num = num + 1
      Grid3.Rows = Grid3.Rows + 1
  
    End If
    rs.MoveNext
  Wend
  rs.Close
  
  LG = EscreveLOG(3, "OpenSTRBDRec - Numero de Registos " & num - 1)
  
  Label31 = "Nº de Mov.[" & num - 1 & "]"
  
  LG = EscreveLOG(1, "OpenSTRBDRec - Fim processo")
  
  OpenSTRBDRec = "OK"

End If

GoTo fim

msgError:

'If rs.State = 1 Then
'  rs.Close
'End If

If OpLG Then
  MsgBox LGBox(92) & rs!recid, vbExclamation          'MSGBOX 92
Else
  MsgBox "Verificou-se um erro na importação REG:" & rs!recid, vbExclamation          'MSGBOX 92
End If
LG = EscreveLOG(9, "OpenSTRBDRec - Verificou-se um erro na importação REG: " & rs!recid)


fim:

End Function


            StatusBar1.Panels.Item(2).Text = "Tentativa numº" & NTntSAP & " de recolha do relatório SAP - Por Favor Aguarde - Proxima em " & 60 - (NTNT * 10) & " segundos"
          End If
          Sleep 10000
        Next
        dieFunc.exports("NDCMC") = ""
        dieFunc.exports("UTILIZ") = ""
        dieFunc.exports("ZFLAG") = "0"
              
        dieFunc.Call
      
        If dieFunc.Tables("TAB_RETORNO_1").Rows.Count <> 0 Then
          Exit For
        End If
      Next
    End If
    If NTntSAP = 7 Then
      If OpLG Then
        MsgBox LGBox(43), vbOKOnly    ' MSGBOX 43
      Else
        MsgBox "Não foi possivel recolher o relatório de SAP. Tente mais tarde...", vbOKOnly    ' MSGBOX 43
      End If
      Frame6.Visible = False
      Exit Sub
    End If
    
    Grid62.Rows = 2
    Grid62.Clear
    Grid62.TextMatrix(0, 0) = "Num"
    Grid62.TextMatrix(0, 1) = "NDCMC"
    Grid62.TextMatrix(0, 2) = "FLAG"
    Grid62.TextMatrix(0, 3) = "MDSAP"
    Grid62.TextMatrix(0, 4) = "MSGER"
    Grid62.TextMatrix(0, 5) = "DTSIS"
    Grid62.TextMatrix(0, 6) = "ZUSER"

    For X = 1 To dieFunc.Tables("TAB_RETORNO_1").Rows.Count
      Set oRow = dieFunc.Tables("TAB_RETORNO_1").Rows(X)
          
      Grid62.TextMatrix(X, 0) = X
      Grid62.TextMatrix(X, 1) = oRow("NDCMC")
      Grid62.TextMatrix(X, 2) = oRow("FLAG")
      Grid62.TextMatrix(X, 3) = oRow("MDSAP")
      Grid62.TextMatrix(X, 4) = oRow("MSGER")
      Grid62.TextMatrix(X, 5) = oRow("DTSIS")
      Grid62.TextMatrix(X, 6) = oRow("ZUSER")
    
      Grid62.Rows = Grid62.Rows + 1
      
      If OpLG Then
        StatusBar1.Panels.Item(2).Text = "RFC GET - " & LGStatus(14) & " " & X & " - Mov. " & Grid62.TextMatrix(X, 1)
      Else
        StatusBar1.Panels.Item(2).Text = "RFC GET - Linha " & X & " - Mov. " & Grid62.TextMatrix(X, 1)
      End If
      
    Next
    
    LG = EscreveLOG(3, "GETRESULTS - Num Registos " & Grid62.Rows + 1)
    
    OpenFileRFC (CFile)

    SQL = "update contabreg set fluxo=(select top 1 flxo from contab where contab.numxu=contabreg.numxu) where contabreg.fluxo is null"
    rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
    
  Else
    If OpLG Then
      MsgBox LGBox(44)    'MSGBOX 44
    Else
      MsgBox "Error when accessing function in R/3!"    'MSGBOX 44
    End If
    Screen.MousePointer = vbDefault          'Deactivate hour glas
    Exit Sub
  
  End If
  
Else
  
' Exporta para ficheiro de texto
  If fso.FileExists(CFile) = True Then
    fso.DeleteFile (CFile)
  End If
  
  LG = EscreveLOG(1, "GETRESULTS - Inicio de criação de fich TXT")
  
  Set ts = fso.CreateTextFile(CFile, True)
  
  For X = 1 To Grid62.Rows - 2
  
    DTL(0) = Trim(Grid62.TextMatrix(X, 1))
    DTL(1) = Trim(Grid62.TextMatrix(X, 2))
    DTL(2) = Trim(Grid62.TextMatrix(X, 3))
    DTL(3) = Trim(Grid62.TextMatrix(X, 4))
    DTL(4) = Trim(Grid62.TextMatrix(X, 5))
    DTL(5) = Trim(Grid62.TextMatrix(X, 6))
    Detail = ""

    For Xx = 0 To 5
      Detail = Detail & DTL(Xx) & " | "
    Next

    ts.WriteLine Detail
    
  Next
  LG = EscreveLOG(3, "GETRESULTS - Num Linhas exportadas: " & X)
  LG = EscreveLOG(3, "GETRESULTS - Fim de criação de fich TXT")
  
  ts.Close

End If
   
Screen.MousePointer = vbDefault          'Deactivate hour glas
    
Exit Sub


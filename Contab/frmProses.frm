NVgtmp = Len(ANLReg(18))
For NuR = 1 To Len(ANLReg(18))
  If Mid(ANLReg(18), NuR, 1) = "." Then
    NVgtmp = NuR
  End If
Next

If Len(ANLReg(18)) - NVgtmp = 0 Then
  If Right(ANLReg(18), 1) = "." Then
    ANLReg(18) = ANLReg(18) & "00"
  Else
    ANLReg(18) = ANLReg(18) & ".00"
  End If
Else
  If Len(ANLReg(18)) - NVgtmp = 1 Then
    ANLReg(18) = ANLReg(18) & "0"
  Else
    ANLReg(18) = ANLReg(18)
  End If
End If


If RX3n1 = 1 Then
  ANLReg(3) = X3ANLcnt1
Else
  ANLReg(5) = X3ANLcnt2
End If

For NuR = 0 To 19
  Txt = Txt & Trim(ANLReg(NuR)) & ";"
Next

ToANLX3 = Txt

GoTo fim

msgError:
  
  txt_LOG ("ToANLX3 - ERRO Mov: " & Trim(Grid31.TextMatrix(Gid, 10)))
'  MsgBox "SQL Export - Erro no Mov " & Trim(Grid31.TextMatrix(Gid, 10)), vbExclamation + vbOKOnly, "Erro"  'MSGBOX 50 e 18

  
fim:


End Function



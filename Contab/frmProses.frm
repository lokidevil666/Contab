Function ToHDRX3RES(ByVal Campo As String) As String
Dim nTH As Integer

ToHDRX3RES = ""
For nTH = 0 To Grid1.Rows - 1
  If Campo = Grid1.TextMatrix(nTH, 0) Then
    ToHDRX3RES = Grid1.TextMatrix(nTH, 3)
    Exit For
  End If
Next

End Function


Function ToHDRX3(ByVal Gid As Integer) As String
On Error GoTo msgError
Dim Txt, HdrReg(40) As String
Dim LtrCod, NuR As Integer

Txt = ""
For NuR = 0 To 39
  HdrReg(NuR) = ""
Next


For NuR = 0 To Grid1.Rows - 2
  Select Case Grid1.TextMatrix(NuR + 1, 0)
    Case "Cabecalho"
      HdrReg(NuR) = Trim(HDRcab)
    
    Case "CONSTANTE"
      HdrReg(NuR) = ToHDRX3RES(Grid1.TextMatrix(NuR + 1, 0))
      
    Case "Data Contab"
      HdrReg(NuR) = Trim(Grid31.TextMatrix(Gid, 5))
      
    Case "Data Valor"
      HdrReg(NuR) = Trim(Grid31.TextMatrix(Gid, 6))
  
    Case "Divisa"
      HdrReg(NuR) = Trim(Grid31.TextMatrix(Gid, 9))
    
    Case "FILLER"
      HdrReg(NuR) = ToHDRX3RES(Grid1.TextMatrix(NuR + 1, 0))
    
    Case "Holding"
      HdrReg(NuR) = X3Estab
'      HdrReg(NuR) = Trim(Grid31.TextMatrix(Gid, 0))
    
    Case "Montante"
      HdrReg(NuR) = Trim(Grid31.TextMatrix(Gid, 8))
    
    Case "Num XU"
      HdrReg(NuR) = Trim(Grid31.TextMatrix(Gid, 10))
    
    Case "Numero Doc"
      HdrReg(NuR) = HDRtipoDOC & "-" & Trim(Grid31.TextMatrix(Gid, 0)) & "-" & Year(Date) & "/" & Right("00000000" & HDRCnt, 6)
    
    Case "Tipo Doc"
      HdrReg(NuR) = HDRtipoDOC
    
  End Select
  
Next

For NuR = 0 To 39
  If HdrReg(NuR) <> "" Then
    Txt = Txt & Trim(HdrReg(NuR)) & ";"
  End If
Next

ToHDRX3 = Txt

GoTo fim

msgError:
  
  txt_LOG ("ToHDRX3 - ERRO Mov: " & Trim(Grid31.TextMatrix(Gid, 10)))
  MsgBox "SQL Export - Erro no Mov " & Trim(Grid31.TextMatrix(Gid, 10)), vbExclamation + vbOKOnly, "Erro"  'MSGBOX 50 e 18

  
fim:


End Function



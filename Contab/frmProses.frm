Function PrimaLineCode(ByVal Linha As String, ByVal TxLine As String, ByVal SocLine As String) As String

Select Case Linha
Case "1"                ' Linha Banco
  PrimaLineCode = "F"
Case "2", "3"           ' Linha Contabilidade 1 e 2
  PrimaLineCode = "O"
Case "4"                ' Linha Analitica
  PrimaLineCode = "A"
Case "5"                ' Linha Função
  PrimaLineCode = "C"
End Select

End Function


Function DevSQLAtr(ByVal SQLvlr As String, ByVal Grid31 As String, ByVal ToTXT2 As String) As String

Sub CreateContabFile()
Dim fso As New FileSystemObject, xfile As File, ts As TextStream

CFile = "c:\xrt\XRTReport.XML"
If fso.FileExists(CFile) = True Then
  fso.DeleteFile (CFile)
End If

Set ts = fso.CreateTextFile(CFile, True)
ts.WriteLine "<report>"

While Not rs.EOF
  ts.WriteLine "<report-line>"
  ts.WriteLine "<strEntryCode>" & rs!ACC_CODE & "</strEntryCode>"
  ts.WriteLine "<strEntryDescription>" & rs!zu_01 & "</strEntryDescription>"
  ts.WriteLine "<iPeriodOrder>" & rs!NATURE & "</iPeriodOrder>"
  ts.WriteLine "<strEntryPeriod>" & rs!VALUE_DATE & "</strEntryPeriod>"
  ts.WriteLine "<iOrderValue>" & rs!FLOW_CODE & "</iOrderValue>"
  ts.WriteLine "<dblAmountValue>" & rs!AMOUNT & "</dblAmountValue>"
  ts.WriteLine "</report-line>"
  
  rs.MoveNext
Wend

ts.WriteLine "</report>"

rs.Close
ts.Close

End Sub


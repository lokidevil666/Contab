Function DevTXTData(ByVal cmpDetail As String, ByVal tmnDetail As String, ByVal TXTDetail As String, ByVal TXTOpcional As String, ByVal TXTOpcional2 As String, ByVal X As Integer) As String
Dim DevTxT, Custo, Cctmp, Atrdta, CODbanco As String


If cmpDetail = "Empresa" Then
  If Left(TXTDetail, 3) = "=ZU" Then
    DevTxT = Left(TXTOpcional & FillChar(tmnDetail, " "), tmnDetail)
  Else
    DevTxT = Left(Trim(Grid31.TextMatrix(X, 0)) & FillChar(tmnDetail, " "), tmnDetail)
  End If
End If
        
If cmpDetail = "ContaGL" Or cmpDetail = "ContaGL+Soc" Then
'Trim(Grid31.TextMatrix(X, 13))
  DevTxT = Left(TXTDetail & FillChar(tmnDetail, " "), tmnDetail)
End If

If cmpDetail = "Conta" Then
  If IsNull(TXTOpcional) Or TXTOpcional = "" Then
    DevTxT = Left(Trim(Grid31.TextMatrix(X, 1)) & FillChar(tmnDetail, " "), tmnDetail)
  Else
    DevTxT = Left(Trim(TXTDetail) & FillChar(tmnDetail, " "), tmnDetail)
  End If
End If
             
If cmpDetail = "CentroCusto" Then
  If IsNull(TXTDetail) Or TXTDetail = "" Then
    DevTxT = Left(FillChar(tmnDetail, " "), tmnDetail)
  Else
    If (TXTOpcional > 15) Then
      If Left(TXTDetail, 1) = "+" Or Left(TXTDetail, 1) = "-" Then
        Custo = Right(TXTDetail, Len(TXTDetail) - 1)
        If Left(TXTDetail, 1) = "-" Then
          DevTxT = Left(Custo & FillChar(tmnDetail, " "), tmnDetail)
        Else
          Cctmp = Custo & FillChar((tmnDetail / 2) - Len(Custo), " ")
          DevTxT = Right(FillChar(tmnDetail, " ") & Cctmp, tmnDetail)
        End If
      Else
        If TXTOpcional2 = "-" Then
          DevTxT = Left(TXTDetail & FillChar(tmnDetail, " "), tmnDetail)
        Else
          Cctmp = TXTDetail & FillChar((tmnDetail / 2) - Len(TXTDetail), " ")
          DevTxT = Right(FillChar(tmnDetail, " ") & Cctmp, tmnDetail)
        End If
      End If
    Else
      If TXTOpcional2 = "R" Then
        DevTxT = Right(FillChar(tmnDetail, " ") & TXTDetail, tmnDetail)
      Else
        DevTxT = Left(TXTDetail & FillChar(tmnDetail, " "), tmnDetail)
      End If
    End If
  End If
End If
        
If cmpDetail = "CIB" Then
  DevTxT = Left(Trim(Grid31.TextMatrix(X, 2)) & FillChar(tmnDetail, " "), tmnDetail)
End If
      
If cmpDetail = "Descricao" Then
  DevTxT = Left(Trim(TXTDetail) & FillChar(tmnDetail, " "), tmnDetail)
End If
        
If cmpDetail = "Fluxo" Then
  DevTxT = Left(Trim(Grid31.TextMatrix(X, 4)) & FillChar(tmnDetail, " "), tmnDetail)
End If
        
If cmpDetail = "Data Contab" Then
  DevTxT = Left(Trim(Grid31.TextMatrix(X, 5)) & FillChar(tmnDetail, " "), tmnDetail)
End If
        
If cmpDetail = "Data Valor" Then
  DevTxT = Left(TXTDetail & FillChar(tmnDetail, " "), tmnDetail)
End If
        
If cmpDetail = "Data Oper" Then

Function RegSAPInfoviaTXT(flFileName As String, Optional FileNumber As Integer = 2, Optional msgMessageError As String = "File do not exist!", Optional msgStyleError As VbMsgBoxStyle = vbOKOnly + vbCritical, Optional msgTitleError As String = "Errore!") As String
On Error GoTo msgError
Dim RowLine, nRowIN, nRowOUT, nRowH, DtlI As Integer
Dim NXUI, NXUT, SAPInfoI, SAPInfoT, SAPStatusI, SAPStatusT As Integer
Dim CNTI, CNTT, EmpI, EmpT As Integer
Dim RowValue, NXU, SAPINFO, SAPSTATUS, SAPConstante, SAPFiller, SAPcnt, SAPEmp As String
Dim NewLine, X As String
  
 
NXUI = 0
NXUT = 0
SAPInfoI = 0
SAPInfoT = 0
SAPStatusI = 0
SAPStatusT = 0
CNTI = 0
CNTT = 0
EmpI = 0
EmpT = 0

For DtlI = 1 To Grid1.Rows - 1
  
  If Grid1.TextMatrix(DtlI, 0) = "Numero XU" Then
    NXUI = Grid1.TextMatrix(DtlI, 1)
    NXUT = Grid1.TextMatrix(DtlI, 2)
  End If
  If Grid1.TextMatrix(DtlI, 0) = "SAP Info" Then
    SAPInfoI = Grid1.TextMatrix(DtlI, 1)
    SAPInfoT = Grid1.TextMatrix(DtlI, 2)
  End If
  If Grid1.TextMatrix(DtlI, 0) = "SAP Status" Then
    SAPStatusI = Grid1.TextMatrix(DtlI, 1)
    SAPStatusT = Grid1.TextMatrix(DtlI, 2)
  End If
  If Grid1.TextMatrix(DtlI, 0) = "CONSTANTE" Then
    SAPConstante = ""
  End If
  If Grid1.TextMatrix(DtlI, 0) = "Conta" Then
    CNTI = Grid1.TextMatrix(DtlI, 1)
    CNTT = Grid1.TextMatrix(DtlI, 2)
  End If
  If Grid1.TextMatrix(DtlI, 0) = "Empresa" Then
    EmpI = Grid1.TextMatrix(DtlI, 1)
    EmpT = Grid1.TextMatrix(DtlI, 2)
  End If
  If Grid1.TextMatrix(DtlI, 0) = "FILLER" Then
    SAPFiller = ""
  End If
  
Next
  
NewLine = Chr$(13) & Chr$(10)
nRowIN = 1
nRowOUT = 1
nRowH = 1
RegSAPInfoviaTXT = Empty

If Dir(flFileName, vbNormal) = "" Then
  MsgBox msgMessageError, msgStyleError, msgTitleError
  Exit Function
End If

Open flFileName For Input As #FileNumber
For RowLine = 0 To LOF(FileNumber)
  Line Input #FileNumber, RowValue
  If EOF(FileNumber) Then
    Exit For
    Exit Function
  End If
    
  If NXUI > 0 Then
    NXU = Mid(RowValue, NXUI, NXUT)
  Else
    NXU = ""
  End If
  
  If SAPInfoI > 0 Then
    SAPINFO = Mid(RowValue, SAPInfoI, SAPInfoT)
  Else
    SAPINFO = ""
  End If
  
  If SAPStatusI > 0 Then
    SAPSTATUS = Mid(RowValue, SAPStatusI, SAPStatusT)
  Else
    SAPSTATUS = ""
  End If
  
  If CNTI > 0 Then
    SAPcnt = Mid(RowValue, CNTI, CNTT)
  Else
    SAPcnt = ""
  End If
  
  If EmpI > 0 Then
    SAPEmp = Mid(RowValue, EmpI, EmpT)
  Else
    SAPEmp = ""
  End If
    
  If NXU <> "" Then
    
    SQL = "update contab set STATUSAP='" & SAPSTATUS & "', DSCSAP='" & SAPINFO & "' where numxu='" & NXU & "'"
    rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
    
    SQL = "update contabreg set integrado=1, sapid='" & SAPINFO & "', sapstatus='" & SAPSTATUS & "' where numxu='" & NXU & "'"
    rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
    
  End If
  
Next RowLine
Close 'FileNumber

Exit Function

msgError:
  If OpLG Then
    MsgBox LGBox(17) & " " & flFileName & ".", vbExclamation + vbOKOnly, LGBox(18) 'MSGBOX 17 e 18
  Else
    MsgBox "Verificou-se um erro ao abrir o ficheiro """ & flFileName & """.", vbExclamation + vbOKOnly, "Erro"  'MSGBOX 17 e 18
  End If
  txt_LOG ("[REGSAPINFOVIATXT] Erro SQL [" & SQL & "]")

End Function


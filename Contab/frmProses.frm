  rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
  PutMovTbl = "Update"
End If

GoTo fim

errHandler:
  txt_LOG ("[PutMovTbl] - SQL [" & LcL & "][" & SQL & "]")

fim:
    
End Function


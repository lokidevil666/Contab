  End If
  
  Open flFileName For Input As #FileNumber
    For RowLine = 0 To LOF(FileNumber)
      Line Input #FileNumber, RowValue
    
      If Left(RowValue, 1) <> ";" Then
      
        ContabUser = Trim(Replace(Left(RowValue, 25), ".", " "))
        ContabOPCAO = Trim(Mid(RowValue, 26, 10))
        
        If Trim(Text17) = ContabUser Then
          If Check11 = ContabOPCAO Then
            txt_LOG ("Opcao Contab Excecao sem alteracoes...[" & ContabUser & "]")
          Else
            txt_LOG ("Opcao Contab Excecao alterada -USER-..[" & ContabUser & "] de [" & Check11 & " para " & ContabOPCAO & "]")
            Check11 = ContabOPCAO
          End If
        End If
        
      End If
   
      If EOF(FileNumber) Then
        Exit For
        Exit Function
      End If
    
    Next RowLine
  Close 'FileNumber
  
  LG = EscreveLOG(1, "OpenContabEXC - Fim processo")

End If
  
GoTo fim

msgError:
  If RowLine = 0 Then
    If OpLG Then
      MsgBox LGBox(88) & " " & flFileName & ".", vbExclamation + vbOKOnly, LGBox(18)    'MSGBOX 88 e 18
      txt_LOG ("ERRO no ficheiro Contab Excecao de Utilizadores.....[" & flFileName & "]")
    Else
      MsgBox "OpenContabEXC - Verificou-se um erro ao abrir o ficheiro """ & flFileName & """.", vbExclamation + vbOKOnly, "Erro"    'MSGBOX 88 e 18
      txt_LOG ("ERRO no ficheiro Contab Excecao de Utilizadores.....[" & flFileName & "]")
    End If
  Else
    txt_LOG ("ERRO ao ler o ficheiro ContabExcecao para o User....[" & ContabUser & "] e opcao [" & ContabOPCAO & "]")
  End If

fim:

End Function



  If NRegB > 0 Then
    
    SQL = "SELECT distinct cash_ledger_id FROM contab_excepcoes WHERE doc_sap LIKE '%ficheiro%' or doc_sap = ';;0000' or doc_sap is null order by cash_ledger_id"
    rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
          
    While Not rs.EOF
          
      XUid = rs!CASH_LEDGER_ID
      Set dieFunc = FunctionCtrl.Add("ZFITR_TL_019")
      Set Order_Table = dieFunc.Tables("T_ZFITR_TL_019")
      Set Order_Line = Order_Table.Rows.Add
    
      Order_Line("DOC_SAGE") = "E" & XUid
      rs.MoveNext
        
    Wend
    rs.Close
        
  End If
    
  NRegB = 0
  SQL = "select count(cash_ledger_id) as NumReg FROM contab_excepcoes_espec WHERE doc_sap LIKE '%ficheiro%' or doc_sap = ';;0000' or doc_sap is null"
  rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
  NRegB = rs!NumReg
  rs.Close
    
  If NRegB > 0 Then
    
    SQL = "SELECT distinct cash_ledger_id FROM contab_excepcoes_espec WHERE doc_sap LIKE '%ficheiro%' or doc_sap = ';;0000' order by cash_ledger_id"
    rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
     
    While Not rs.EOF
          
      XUid = rs!CASH_LEDGER_ID
      Set dieFunc = FunctionCtrl.Add("ZFITR_TL_019")
      Set Order_Table = dieFunc.Tables("T_ZFITR_TL_019")
      Set Order_Line = Order_Table.Rows.Add
    
      Order_Line("DOC_SAGE") = "E" & XUid
      rs.MoveNext
        
    Wend
    rs.Close
   
  End If
   
   
  If dieFunc.Call = True Then
  
    NREG = dieFunc.Tables("T_ZFITR_TL_019").Rows.Count

    For X = 1 To NREG
       
      Set oRow = dieFunc.Tables("T_ZFITR_TL_019").Rows(X)
       
      XUidT = Trim(oRow("DOC_SAGE"))
      XUid = Right(XUidT, Len(XUidT) - 1)
    
      CBukrsSAP = Trim(oRow("BUKRS_SAP"))
      CBelnrSAP = Trim(oRow("BELNR_SAP"))
      CGjahrSAP = Trim(oRow("GJAHR_SAP"))
      CBukrsSAPInt = Trim(oRow("BUKRS_SAP_INT"))
      CBelnrSAPInt = Trim(oRow("BELNR_SAP_INT"))
      CGjahrSAPInt = Trim(oRow("GJAHR_SAP_INT"))
      
      If Trim(CBukrsSAP) = "" Then
        If Trim(CBukrsSAPInt) = "" Then
          BUKRS = ""
        Else
          BUKRS = CBukrsSAPInt
        End If
      Else
        If Trim(CBukrsSAPInt) = "" Then
          BUKRS = CBukrsSAP
        Else
          If CBukrsSAP = CBukrsSAPInt Or Trim(CBukrsSAPInt) = "" Then
            BUKRS = CBukrsSAP
          Else
            BUKRS = CBukrsSAP & "'" & CBukrsSAPInt
          End If
        End If
      End If
      
      If Trim(CBelnrSAP) = "" Then
        If Trim(CBelnrSAPInt) = "" Then
          BELNR = ""
        Else
          BELNR = CBelnrSAPInt
        End If
      Else
        If CBelnrSAP = CBelnrSAPInt Or Trim(CBelnrSAPInt) = "" Then
          BELNR = CBelnrSAP
        Else
          BELNR = CBelnrSAP & "'" & CBelnrSAPInt
        End If
      End If
      
      If Trim(CGjahrSAP) = "" Then
        If Trim(CGjahrSAPInt) = "" Then
          GJAHR = ""
        Else
          GJAHR = CGjahrSAPInt
        End If
      Else
        If CGjahrSAP = CGjahrSAPInt Or Trim(CGjahrSAPInt) = "" Or Trim(CGjahrSAPInt) = "0000" Then
          GJAHR = CGjahrSAP
        Else
          GJAHR = CGjahrSAP & "'" & CGjahrSAPInt
        End If
      End If
            
      If XUid <> "" Then
        
        RegACC = RegACC + 1
        
        
        If Left(XUidT, 1) = "E" Then
        
          SQL = "select count(fluxogl) as NRg FROM contab_excepcoes WHERE CASH_LEDGER_ID='" & XUid & "'"
          rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
          nRegTMP = rs!NrG
          rs.Close
          
          If nRegTMP > 0 Then
            SQL = "UPDATE CONTAB_EXCEPCOES SET DOC_SAP='" & BUKRS & ";" & BELNR & ";" & GJAHR & "' WHERE CASH_LEDGER_ID='" & XUid & "'"
            rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
        
            SQL = "UPDATE CONTAB SET DSCSAP='" & BUKRS & ";" & BELNR & ";" & GJAHR & "', NUMSAP='" & BUKRS & ";" & BELNR & ";" & GJAHR & "' WHERE NUMXU='" & XUidT & "'"
            rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
          Else
            SQL = "select count(fluxogl) as NRg FROM contab_excepcoes_espec WHERE CASH_LEDGER_ID='" & XUid & "'"
            rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
            nRegTMP = rs!NrG
            rs.Close
            
            If nRegTMP > 0 Then
              SQL = "UPDATE CONTAB_EXCEPCOES_ESPEC SET DOC_SAP='" & BUKRS & ";" & BELNR & ";" & GJAHR & "' WHERE CASH_LEDGER_ID='" & XUid & "'"
              rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
        
              SQL = "UPDATE CONTAB SET DSCSAP='" & BUKRS & ";" & BELNR & ";" & GJAHR & "', NUMSAP='" & BUKRS & ";" & BELNR & ";" & GJAHR & "' WHERE NUMXU='" & XUidT & "'"
              rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
            End If
          End If
          
        Else
        
          SQL = "UPDATE CASH_LEDGER SET ZU_02='" & BUKRS & ";" & BELNR & ";" & GJAHR & "' WHERE CASH_LEDGER_ID=" & XUid
          rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
        
          SQL = "UPDATE CONTAB SET DSCSAP='" & BUKRS & ";" & BELNR & ";" & GJAHR & "', NUMSAP='" & BUKRS & ";" & BELNR & ";" & GJAHR & "' WHERE NUMXU='N" & XUid & "'"
          rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
          
        End If ' IF do XUidT
        
      Else
    
        NRegACC = NRegACC + 1
      
      End If
    
    Next 'Nreg
            
    If ConfOPT <> "0" Then
      If OpLG Then
        MsgBox RegACC & " " & LGBox(45) & ". " & NRegACC & " " & LGBox(46)   'MSGBOX 45 e 46
      Else
        MsgBox RegACC & " Registos marcados. " & NRegACC & " Sem DOC SAP."  'MSGBOX 45 e 46
      End If
      
    End If
        
  Else
  
    If ConfOPT <> "0" Then
      
      If OpLG Then
        MsgBox LGBox(48)       'MSGBOX 48
      Else
        MsgBox "Não existem dados para recolha do Numero SAP!" 'MSGBOX 48
      End If
      
    End If

  End If
   
  Screen.MousePointer = vbDefault          'Deactivate hour glas
    
Else

  If ConfOPT <> "0" Then
    If OpLG Then
      MsgBox LGBox(48), vbOKOnly   'MSGBOX 48
    Else
      MsgBox "Não há movimentos a aguardar retorno de SAP", vbOKOnly   'MSGBOX 48
    End If
  End If

End If

Exit Sub

msgError:
  
  If ConfOPT <> "0" Then
    If OpLG Then
      MsgBox LGBox(49) & XUid   'MSGBOX 49
    Else
      MsgBox "Erro ao aceder ao movimento N" & XUid   'MSGBOX 49
    End If
  End If
  
End Sub



Function CheckADMINtxt(ByVal Linha As String, ByVal Vg As Integer) As String
On Error GoTo msgError
Dim NRtxt, nrVGi, nrVGf, nVG, Pos As Integer
Dim Verifica As Boolean

nrVGi = 0
nrVGf = 0
nVG = 0
Pos = 0
Verifica = True

If Vg = 99 Then
  Vg = 1
  Pos = 1
  For NRtxt = Len(Linha) To 1 Step -1
    If Mid(Linha, NRtxt, 1) = "," Then
      nrVGi = NRtxt
      nrVGf = Len(Linha)
      nVG = nVG + 1
    End If
    
    If nVG = Vg Then
      Pos = 2
      CheckADMINtxt = Mid(Linha, nrVGi + 1, Len(Linha))
      Exit For
    End If
    
  Next
Else
  Pos = 3
  For NRtxt = 1 To Len(Linha)
    If Asc(Mid(Linha, NRtxt, 1)) = 34 And Verifica Then   ' Verifica se é  ' " '
       Verifica = False
    Else
      If Asc(Mid(Linha, NRtxt, 1)) = 34 Then
        Verifica = True
      End If
    End If
    
    If Mid(Linha, NRtxt, 1) = "," And Verifica Then
      Pos = 4
      nrVGi = nrVGf
      nrVGf = NRtxt
      nVG = nVG + 1
    End If
    
    If nVG = Vg Then
      Pos = 5
      CheckADMINtxt = Mid(Linha, nrVGi + 1, nrVGf - nrVGi - 1)
      
      If (nrVGf - nrVGi - 1) = 0 Then
        CheckADMINtxt = ""
      Else
        CheckADMINtxt = Mid(Linha, nrVGi + 1, nrVGf - nrVGi - 1)
        If Asc(Left(CheckADMINtxt, 1)) = 34 Then
          Pos = 6
          CheckADMINtxt = Mid(CheckADMINtxt, 2, Len(CheckADMINtxt))
        End If
      
        If Asc(Right(CheckADMINtxt, 1)) = 34 Then
          Pos = 7
          CheckADMINtxt = Left(CheckADMINtxt, Len(CheckADMINtxt) - 1)
        End If
      End If
      
      Exit For
    End If
    
  Next
End If

Exit Function

msgError:
  txt_LOG ("CheckADMINtxt ERRO Pos[" & Pos & "] Registo [" & Linha & "]")
  CheckADMINtxt = ""

End Function



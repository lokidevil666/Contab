Sub GravaContabBD(IDTBL As String)
On Error GoTo errHandler
Dim NRow, G31Cnt, G3Cnt As Integer

LG = EscreveLOG(1, "GRAVACONTABBD - Inicio do Processo " & IDTBL)
G31Cnt = 0
G3Cnt = 0
OP = OP

Select Case IDTBL
Case "contab"
  For NRow = 1 To Grid31.Rows - 2
    If Trim(Grid31.TextMatrix(NRow, 10)) <> "" Then
      StatusBar1.Panels.Item(2).Text = "CONTAB - Mov " & Grid31.TextMatrix(NRow, 10) & " - Faltam [" & Grid31.Rows - 2 - NRow & "]"
      SendSQLBD (NRow)
      G31Cnt = G31Cnt + 1
    End If
  Next
  txt_LOG ("[GRAVAContabBD][" & IDTBL & "] Movimentos Integrados....[" & G31Cnt & "/" & Grid31.Rows - 2 & "]")
  
  
Case "contabreg"
  For NRow = 1 To Grid3.Rows - 2
    If Trim(Grid3.TextMatrix(NRow, 12)) <> "" Then
      StatusBar1.Panels.Item(2).Text = "CONTABREG - Mov " & Grid3.TextMatrix(NRow, 12) & " - Faltam [" & Grid3.Rows - 2 - NRow & "]"
      SendSQLBDRegContab (NRow)
      G3Cnt = G3Cnt + 1
    End If
  Next
  txt_LOG ("[GRAVAContabBD][" & IDTBL & "/" & OP & "] Movimentos Integrados....[" & G3Cnt & "/" & Grid3.Rows - 2 & "]")

End Select

LG = EscreveLOG(1, "GRAVAContabBD - Fim do Processo " & IDTBL)

GoTo fim

errHandler:
  If IDTBL = "contab" Then
    txt_LOG ("[GRAVAContabBD][" & IDTBL & "] - ERRO no envido para BD - Mov.ID [" & Grid31.TextMatrix(NRow, 10) & "]")
  Else
    txt_LOG ("[GRAVAContabBD][" & IDTBL & "] - ERRO no envido para BD - Mov.ID [" & Grid3.TextMatrix(NRow, 12) & "]")
  End If
  
fim:

End Sub


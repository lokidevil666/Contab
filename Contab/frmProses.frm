Sub EstadoContb(ORDEM As Integer)
Dim num As Integer

  If Check8 = 1 Then
    If Check5 = 1 Then
      SQL = "select top " & Label50 & " CASH_LEDGER_ID AS RegID, '04' AS Tipo, ENTRY_DATE AS ImportDate,FLOW_CODE AS CIB, BOOK_DATE AS BOOKDATE, DESCRIPTION AS Descricao, VALUE_DATE AS DataMov,(select electronic_value from ba_number_items_acc where baf_item_id='164' and acc_code=cash_ledger.acc_code) AS Conta,TRN_AMOUNT AS Montante, CUR_CODE AS Divisa, CASH_LEDGER_ID AS NUMXU, ZU_02 AS FLX, 'Nao Contabilizar' AS SAPSTATUS"
      SQL = SQL & " From CASH_LEDGER where left(ZU_02,2)='NC'"
    Else
      SQL = "select top " & Label50 & " NREC_BANK_MVT_ID AS RegID, '04' AS Tipo, IMPORT_DATE AS ImportDate, BANK_FLOW_CODE AS CIB, BOOK_DATE AS BOOKDATE, DESCRIPTION AS Descricao, VALUE_DATE AS DataMov, "
      SQL = SQL & "(select electronic_value from ba_number_items_acc where baf_item_id='164' and acc_code=nrec_bank.acc_code) AS Conta, TRN_AMOUNT AS Montante, TRN_CUR AS Divisa, NREC_BANK_MVT_ID AS NUMXU, ZU_02 AS FLX, 'Nao Contabilizar' AS SAPSTATUS from NREC_BANK where left(ZU_02,2)='NC'"
    End If
  
  Else
    SQL = "select top " & Label50 & " contabregid as REGID, Tipo AS TIPO, ImportDate AS IMPORTDATE, CIB AS CIB, BookDate AS BOOKDATE, Descricao AS DESCRICAO, NumCheque AS NUMCHEQUE, DataMov AS DATAMOV, Conta AS CONTA, Montante AS MONTANTE, Sinal AS SINAL, Divisa AS DIVISA, Desc2 AS DESC2, NumXU AS NUMXU, isnull(SAPstatus,(select DSCSAP from CONTAB Where contabreg.Numxu=contab.numxu )) AS SAPSTATUS, isnull(fluxo,(select FLXO from CONTAB Where contabreg.Numxu=contab.numxu )) AS FLX, Integrado AS INTEGRADO FROM ContabREG WHERE tipo<>''"
    
    If Check3 = 1 Or Check4 = 1 Then
  '    SQL = "select contabid AS ContabRegID, '04' AS Tipo, dtcont AS ImportDate, contab.cib AS CIB, dtvalor AS BOOKDATE, dsc AS Descricao, numcheque, dtoper AS DataMov, cnt AS Conta, mnt AS Montante, divsa AS Divisa, desc2, contab.numxu AS NUMXU, flxo AS FLX, dscsap AS SAPSTATUS, Integrado AS Integrado from contab INNER JOIN ContabREG ON Contab.NumXU = Contabreg.NumXU WHERE EMP<>'' and INTEGRADO=1 "
      SQL = "select top " & Label50 & " contabid AS RegID, '04' AS Tipo, dtcont AS ImportDate, contab.cib AS CIB, dtvalor AS BOOKDATE, dsc AS Descricao, dtoper AS DataMov, cnt AS Conta, mnt AS Montante, divsa AS Divisa, numxu AS NUMXU, flxo AS FLX, dscsap AS SAPSTATUS from contab where contabid > 0 "
    End If
  
    If Check4 = 1 Then
      SQL = SQL & "AND FLXO='NC' "
    End If
    
    If Check3 = 1 Then
      SQL = SQL & "AND FLXO<>'NC' "
    End If
    
  End If
  
  If Text1 = "" Or Text1 = "Inicio" Then
    If Text2 = "" Or Text2 = "Fim" Then
      SQL = SQL & ""
    Else
      If Check8 = 1 Then
        SQL = SQL & " and  BOOK_DATE <='" & Text2 & "' "
      Else
        If Check3 = 1 Or Check4 = 1 Then
          SQL = SQL & " and dtoper <='" & Text2 & "' "
        Else
          SQL = SQL & " and datamov <='" & Text2 & "' "
        End If
      End If
    End If
  Else
    If Text2 = "" Or Text2 = "Fim" Then
      If Check8 = 1 Then
        SQL = SQL & " and BOOK_DATE >='" & Text1 & "' "
      Else
        If Check3 = 1 Or Check4 = 1 Then
          SQL = SQL & " and dtoper >='" & Text1 & "' "
        Else
          SQL = SQL & " and datamov >='" & Text1 & "' "
        End If
      End If
    Else
      If Check8 = 1 Then
        SQL = SQL & " and ( BOOK_DATE between '" & Text1 & "' and '" & Text2 & "' ) "
      Else
        If Check3 = 1 Or Check4 = 1 Then
          SQL = SQL & " and ( dtoper between '" & Text1 & "' and '" & Text2 & "' ) "
        Else
          SQL = SQL & " and ( datamov between '" & Text1 & "' and '" & Text2 & "' ) "
        End If
      End If
    End If
  End If
  
  If Combo6 = "" Then
    SQL = SQL & ""
  Else
    If Check8 = 1 Then
      SQL = SQL & " and acc_code='" & Trim(Combo6) & "'"
    Else
      If Check3 = 1 Or Check4 = 1 Then
        SQL = SQL & " and cnt like '%" & Trim(Combo6) & "%'"
      Else
        SQL = SQL & " and conta like '%" & Trim(Combo6) & "%'"
      End If
    End If
  End If
  
  If txtFile <> "" Then
    If Check8 = 1 Then
      SQL = SQL & " and ( DESCRIPTION like '%" & txtFile & "%' or TRN_AMOUNT like '%" & txtFile & "%' ) "
    Else
      If Check3 = 1 Or Check4 = 1 Then
        SQL = SQL & " and ( dsc like '%" & txtFile & "%' or cnt like '%" & txtFile & "%' or mnt like '%" & txtFile & "%' or dscsap like '%" & txtFile & "%') "
      Else
        SQL = SQL & " and ( descricao like '%" & txtFile & "%' or conta like '%" & txtFile & "%' or montante like '%" & txtFile & "%' ) "
      End If
    End If
  End If
   
  Select Case ORDEM
  Case "0", "13"
    If Check3 = 1 Or Check4 = 1 Then
      SQL = SQL & " order by Contab.numxu desc"
    Else
      If Check8 = 1 Then
        SQL = SQL & ""
      Else
        SQL = SQL & " order by ContabREG.numxu desc"
      End If
    End If
  
  Case "2"
    If Check3 = 1 Or Check4 = 1 Then
      SQL = SQL & " order by Contab.dtcont desc"
    Else
      If Check8 = 1 Then
        SQL = SQL & ""
      Else
        SQL = SQL & " order by ContabREG.importdate desc"
      End If
    End If
    
  Case "4"

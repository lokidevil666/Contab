Function VerifyContabINI(Tpo As String) As String
On Error GoTo errHandler
Dim Campo, Tabela As String
Dim TmDif As Double

Campo = "DATAIN"
Tabela = "CONFG"


If Tpo = "VRFY" Then
  SQL = "SELECT TOP 1 datediff(n,datain,GETDATE()) as DF FROM CONFG where tipo='cntbinicio'"
  rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
  TmDif = rs!DF
  rs.Close

  If TmDif < 30 Then
    VerifyContabINI = False
    txt_LOG ("CONTAB INI foi executado [" & TmDif & " min], menos de 15 minutos. Processo Cancelado. ")
  Else
    SQL = "update Confg set datain=getdate() where tipo='cntbinicio'"
    rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
    VerifyContabINI = True
  End If
End If


If Tpo = "UPDT" Then
  SQL = "update Confg set datain=getdate() where tipo='cntbinicio'"
  rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
End If

GoTo fim

errHandler:

    txt_LOG ("[ERRO CONTAB INI Criação - Campo DATAIN na tabela CONFG -")
     
    SQL = "ALTER TABLE CONFG ADD DATAIN datetime null"
    rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
    
    SQL = "INSERT INTO Confg (Tipo, DATAIN) VALUES ('CntbINICIO',getdate())"
    rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
      
fim:

End Function



Function SepIntDec(ByVal Vlr As String, TpOut As String) As String
Dim VlrD, VlrI, CX, Vr As Integer

Vr = 0
VlrI = 0
VlrD = 0
For CX = 1 To Len(Vlr)
  If Mid(Vlr, CX, 1) = "." Or Mid(Vlr, CX, 1) = "," Then
    Vr = CX
    Exit For
  End If
Next

If Vr = 0 Then
  VlrI = Vlr
  Vlr = 0
Else
  VlrI = Left(Vlr, Vr - 1)
  VlrD = Mid(Vlr, Vr + 1, 5)
End If

If TpOut = "INT" Then
  SepIntDec = VlrI
Else
  If TpOut = "DEC" Then
    SepIntDec = VlrD
  Else
    SepIntDec = Vlr
  End If
End If

End Function


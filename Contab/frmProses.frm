Function OpenSTRFile(flFileName As String, Optional FileNumber As Integer = 2, Optional msgMessageError As String = "File do not exist!!", Optional msgStyleError As VbMsgBoxStyle = vbOKOnly + vbCritical, Optional msgTitleError As String = "Errore!") As String
On Error GoTo msgError
Dim RowLine, nRowIN, nRowOUT, nRowH, NR, nRa As Integer
Dim RowValue, Celrow As String
Dim NewLine, X As String
  
  NewLine = Chr$(13) & Chr$(10)
  nRowIN = 1
  nRowOUT = 1
  nRowH = 1
  OpenSTRFile = Empty
  If Dir(flFileName, vbNormal) = "" Then
    MsgBox msgMessageError, msgStyleError, msgTitleError
    Exit Function
  End If
  
  Text20 = 1
  Text23 = 1
  Grid22.Rows = 1
  Grid22.Cols = 1
  Grid22.TextMatrix(0, 0) = 1
  Grid22.ColWidth(0) = 600
  
  Grid25.Rows = 2
  Grid25.Cols = 6
  Grid25.ColWidth(0) = 1700
  Grid25.ColWidth(1) = 700
  Grid25.ColWidth(2) = 900
  Grid25.ColWidth(3) = 800
  Grid25.ColWidth(4) = 1000
  Grid25.ColWidth(5) = 1000
  
  If OpLG Then
    Grid25.TextMatrix(0, 0) = LGGrid(69)
    Grid25.TextMatrix(0, 1) = LGGrid(0)
    Grid25.TextMatrix(0, 2) = LGGrid(73)
    Grid25.TextMatrix(0, 3) = LGGrid(74)
    Grid25.TextMatrix(0, 4) = LGGrid(72)
    Grid25.TextMatrix(0, 5) = LGGrid(68)
  Else
    Grid25.TextMatrix(0, 0) = "Nome"
    Grid25.TextMatrix(0, 1) = ""
    Grid25.TextMatrix(0, 2) = "Ligação"
    Grid25.TextMatrix(0, 3) = "Len"
    Grid25.TextMatrix(0, 4) = "Valor"
    Grid25.TextMatrix(0, 5) = "Obs"
  End If
  
  Celrow = "&HC0FFFF"
  
  Open flFileName For Input As #FileNumber
  For RowLine = 0 To LOF(FileNumber)
    Line Input #FileNumber, RowValue
    If EOF(FileNumber) Then
      Exit For
      Exit Function
    End If
    Select Case Mid(RowValue, 31, 3)
    Case "IN "
      Grid1.TextMatrix(nRowIN, 0) = Trim(Mid(RowValue, 2, 20))
      Grid1.TextMatrix(nRowIN, 1) = Val(Mid(RowValue, 23, 3))
      Grid1.TextMatrix(nRowIN, 2) = Val(Mid(RowValue, 27, 3))
      Grid1.TextMatrix(nRowIN, 3) = Trim(Mid(RowValue, 35, 10))
      
      Grid25.TextMatrix(Grid25.Rows - 1, 0) = Trim(Mid(RowValue, 2, 20))
      'Grid25.TextMatrix(Grid25.Rows-1, 1) = Trim(Mid(RowValue, 31, 3))
      Grid25.TextMatrix(Grid25.Rows - 1, 1) = "HDR"
      Grid25.TextMatrix(Grid25.Rows - 1, 2) = Val(Mid(RowValue, 23, 3))
      Grid25.TextMatrix(Grid25.Rows - 1, 3) = Val(Mid(RowValue, 27, 3))
      Grid25.TextMatrix(Grid25.Rows - 1, 4) = Trim(Mid(RowValue, 35, 10))
      
      Grid1.Rows = Grid1.Rows + 1
      Grid25.Rows = Grid25.Rows + 1
            
      Grid22.Cols = Grid22.Cols + Val(Grid1.TextMatrix(nRowIN, 2))
      Text23 = Grid22.Cols
      For nRa = Val(Grid22.TextMatrix(0, 0)) To Val(Grid1.TextMatrix(nRowIN, 2)) + Val(Grid22.TextMatrix(0, 0)) - 1
        Grid22.Row = 0
        Grid22.Col = nRa
        Grid22.CellBackColor = Celrow
      Next
      Grid22.TextMatrix(0, 0) = Val(Grid22.TextMatrix(0, 0)) + Val(Grid1.TextMatrix(nRowIN, 2))
      
      If Celrow = "&HC0FFFF" Then
        Celrow = "&HFFFFC0"
      Else
        Celrow = "&HC0FFFF"
      End If

      If Text20 = 2 Or Text20 = 3 Then
      Else
        Text20 = 1
        Grid22.Rows = Text20
      End If
      
      nRowIN = nRowIN + 1
      Grid1.TextMatrix(nRowIN, 0) = "*"

      
    Case "OUT"
        Grid2.TextMatrix(nRowOUT, 0) = Trim(Mid(RowValue, 2, 20))
        Grid2.TextMatrix(nRowOUT, 1) = Val(Mid(RowValue, 23, 3))
        Grid2.TextMatrix(nRowOUT, 2) = Val(Mid(RowValue, 27, 3))
        Grid2.TextMatrix(nRowOUT, 3) = Trim(Mid(RowValue, 35, 10))
        
        Grid25.TextMatrix(Grid25.Rows - 1, 0) = Trim(Mid(RowValue, 2, 20))
      ' Grid25.TextMatrix(Grid25.Rows - 1, 1) = Trim(Mid(RowValue, 31, 3))
        Grid25.TextMatrix(Grid25.Rows - 1, 1) = "LNHA"
        Grid25.TextMatrix(Grid25.Rows - 1, 2) = Val(Mid(RowValue, 23, 3))
        Grid25.TextMatrix(Grid25.Rows - 1, 3) = Val(Mid(RowValue, 27, 3))
        Grid25.TextMatrix(Grid25.Rows - 1, 4) = Trim(Mid(RowValue, 35, 10))
      
        Grid25.Rows = Grid25.Rows + 1
        Grid2.Rows = Grid2.Rows + 1
                       
        If Text20 = 2 Or Text20 = 3 Then
          If Val(Grid2.TextMatrix(nRowOUT, 2)) + Val(Grid22.TextMatrix(1, 0)) > Grid22.Cols Then
            Grid22.Cols = Val(Grid2.TextMatrix(nRowOUT, 2)) + Val(Grid22.TextMatrix(1, 0))
            Text23 = Grid22.Cols
          End If
        Else
          Text20 = 3
          Grid22.Rows = 3
          Grid22.TextMatrix(1, 0) = 1
          Grid22.TextMatrix(2, 0) = 1
        End If
        For nRa = Val(Grid22.TextMatrix(1, 0)) To Val(Grid2.TextMatrix(nRowOUT, 2)) + Val(Grid22.TextMatrix(1, 0)) - 1
          Grid22.Row = 1
          Grid22.Col = nRa
          Grid22.CellBackColor = Celrow
          Grid22.Row = 2
          Grid22.Col = nRa
          Grid22.CellBackColor = Celrow
        Next
        Grid22.TextMatrix(1, 0) = Val(Grid22.TextMatrix(1, 0)) + Val(Grid2.TextMatrix(nRowOUT, 2))
        Grid22.TextMatrix(2, 0) = Grid22.TextMatrix(1, 0)

        If Celrow = "&HC0FFFF" Then
          Celrow = "&HFFFFC0"
        Else
          Celrow = "&HC0FFFF"
        End If
        
        nRowOUT = nRowOUT + 1
        Grid2.TextMatrix(nRowOUT, 0) = "*"

    Case "HDR"
        Grid21.TextMatrix(nRowH, 0) = Trim(Mid(RowValue, 2, 20))
        Grid21.TextMatrix(nRowH, 1) = Val(Mid(RowValue, 23, 3))
        Grid21.TextMatrix(nRowH, 2) = Val(Mid(RowValue, 27, 3))
        Grid21.TextMatrix(nRowH, 3) = Trim(Mid(RowValue, 35, 10))
        
        Grid25.TextMatrix(Grid25.Rows - 1, 0) = Trim(Mid(RowValue, 2, 20))
      ' Grid25.TextMatrix(Grid25.Rows - 1, 1) = Trim(Mid(RowValue, 31, 3))
        Grid25.TextMatrix(Grid25.Rows - 1, 1) = "LNHB"
        Grid25.TextMatrix(Grid25.Rows - 1, 2) = Val(Mid(RowValue, 23, 3))
        Grid25.TextMatrix(Grid25.Rows - 1, 3) = Val(Mid(RowValue, 27, 3))
        Grid25.TextMatrix(Grid25.Rows - 1, 4) = Trim(Mid(RowValue, 35, 10))
      
        Grid25.Rows = Grid25.Rows + 1
        Grid21.Rows = Grid21.Rows + 1
        
        nRowH = nRowH + 1
        Grid21.TextMatrix(nRowH, 0) = "*"
        If Text20 = 3 Then
        Else
          Text20 = 3
          Grid22.Rows = Text20
          Grid22.TextMatrix(2, 0) = 3
        End If

    End Select
  Next RowLine
  Close 'FileNumber
  
  For NR = 1 To Text23 - 1
    Grid22.ColWidth(NR) = 200
  Next
   
  Exit Function

msgError:
  If OpLG Then
    MsgBox LGBox(17) & " " & flFileName & ".", vbExclamation + vbOKOnly, LGBox(18)  'MSGBOX 17 e 18
    txt_LOG ("ERRO no ficheiro Estruturas...........[" & flFileName & "]")
  Else
    MsgBox "Verificou-se um erro ao abrir o ficheiro " & flFileName & ".", vbExclamation + vbOKOnly, "Erro"  'MSGBOX 17 e 18
    txt_LOG ("ERRO no ficheiro Estruturas...........[" & flFileName & "]")
  End If


End Function

Function OpenSTRIN(flFileName As String, Optional FileNumber As Integer = 2, Optional msgMessageError As String = "File do not exist!!", Optional msgStyleError As VbMsgBoxStyle = vbOKOnly + vbCritical, Optional msgTitleError As String = "Errore!") As String
On Error GoTo msgError
Dim RowLine, RowGrid, nRowIN, nRowOUT As Integer
Dim RowValue, NewLine As String
  
LG = EscreveLOG(1, "OpenSTRIN - Inicio processo")
  
  NewLine = Chr$(13) & Chr$(10)
  nRowIN = 1
  nRowOUT = 1
  Grid3.Cols = Grid1.Rows - 2
  OpenSTRIN = Empty
  If Dir(flFileName, vbNormal) = "" Then
    LG = EscreveLOG(9, "OpenSTRIN - Erro na abertura ficheiro " & flFileName)
    MsgBox msgMessageError, msgStyleError, msgTitleError
    Exit Function
  End If
  
  Open flFileName For Input As #FileNumber
  For RowLine = 0 To LOF(FileNumber)
    Line Input #FileNumber, RowValue
    If EOF(FileNumber) Then
      Exit For
      Exit Function
    End If
    
    If Left(RowValue, 2) = "04" Then
      For RowGrid = 1 To Grid3.Cols
        Grid3.TextMatrix(0, RowGrid - 1) = Trim(Grid1.TextMatrix(RowGrid, 0))
        Grid3.TextMatrix(nRowIN, RowGrid - 1) = Trim(Mid(RowValue, Grid1.TextMatrix(RowGrid, 1), Grid1.TextMatrix(RowGrid, 2)))
      Next
      Grid3.Rows = Grid3.Rows + 1
      nRowIN = nRowIN + 1
    End If
  Next RowLine
  Close 'FileNumber
  Grid3.Cols = Grid3.Cols + 2
  Grid3.TextMatrix(0, Grid3.Cols - 2) = "Numero XU"
  Grid3.TextMatrix(0, Grid3.Cols - 1) = "Integrado"
  
  LG = EscreveLOG(3, "OpenSTRIN - Numero de registos " & nRowIN - 1)
  
  Label31 = "Nº de Mov.[" & nRowIN - 1 & "]"
  
  LG = EscreveLOG(1, "OpenSTRIN - Fim processo")
  
  GoTo fim

msgError:
    If OpLG Then
      MsgBox LGBox(17) & " " & flFileName & ".", vbExclamation + vbOKOnly, LGBox(18)  'MSGBOX 17 e 18
    Else
      MsgBox "Verificou-se um erro ao abrir o ficheiro " & flFileName & ".", vbExclamation + vbOKOnly, "Erro"  'MSGBOX 17 e 18
    End If

fim:

End Function



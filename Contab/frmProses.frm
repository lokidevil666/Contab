Sub SendSQLBD(ID As Long)
On Error GoTo errHandler
Dim NREG As Integer
Dim Operacao As String

Operacao = "Lcl [1001] - SELECT"
NREG = 0
SQL = "select COUNT(NUMXU) AS TReg from CONTAB WHERE NUMXU='" & Trim(Grid31.TextMatrix(ID, 10)) & "'"
rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
NREG = rs!treg
rs.Close

If NREG < 1 Then
  Operacao = "Lcl [1002] - INSERT"
  If Trim(Grid31.TextMatrix(ID, 19)) = "" Or Trim(Grid31.TextMatrix(ID, 4)) = "NC" Then
    SQL = "INSERT INTO CONTAB (EMP, CNT, CIB, DSC, FLXO, DTCONT, DTVALOR, DTOPER, MNT, DIVSA, NumXU, CHVLNC, BNK, CNTGL, CNTPRT1, MNT1, CHVLNC1, STATUSAP, DSCSAP, REGRAID, OBS, LOTE) VALUES ('"
'    SQL = "INSERT INTO CONTAB (EMP, CNT, CIB, CNTPRT1, CHVLNC1, MNT1, STATUSAP, DSCSAP) VALUES ('"
  Else
    SQL = "INSERT INTO CONTAB (EMP, CNT, CIB, DSC, FLXO, DTCONT, DTVALOR, DTOPER, MNT, DIVSA, NumXU, CHVLNC, BNK, CNTGL, CNTPRT1, MNT1, CHVLNC1, CNTPRT2, MNT2, CHVLNC2, STATUSAP, DSCSAP, REGRAID, OBS, LOTE) VALUES ('"
'    SQL = "INSERT INTO CONTAB (EMP, CNT, CIB, CNTPRT1, CHVLNC1, MNT1, CNTPRT2, CHVLNC2, MNT2, STATUSAP, DSCSAP) VALUES ('"
  End If

  SQL = SQL & Left(Trim(Grid31.TextMatrix(ID, 0)), 5) & "', '"    ' Empresa
  SQL = SQL & Trim(Grid31.TextMatrix(ID, 1)) & "', '"             ' Conta
  SQL = SQL & Trim(Grid31.TextMatrix(ID, 2)) & "', '"             ' CIB
  SQL = SQL & Left(Trim(Grid31.TextMatrix(ID, 3)), 50) & "', '"   ' Descrição
  SQL = SQL & Left(Trim(Grid31.TextMatrix(ID, 4)), 50) & "', "    ' Fluxo
  SQL = SQL & "getdate(), '"                                      ' Data Contabilização
  'SQL = SQL & Left(Trim(Grid31.TextMatrix(ID, 4)), 30) & "', '"   ' Fluxo
  'SQL = SQL & Left(Trim(Grid31.TextMatrix(ID, 5)), 4) & "-" & Mid(Trim(Grid31.TextMatrix(ID, 5)), 5, 2) & "-" & Right(Trim(Grid31.TextMatrix(ID, 5)), 2) & "', '"   ' Data Contab
  SQL = SQL & Left(Trim(Grid31.TextMatrix(ID, 6)), 4) & "-" & Mid(Trim(Grid31.TextMatrix(ID, 6)), 5, 2) & "-" & Right(Trim(Grid31.TextMatrix(ID, 6)), 2) & "', '"   ' Data Valor
  SQL = SQL & Left(Trim(Grid31.TextMatrix(ID, 7)), 4) & "-" & Mid(Trim(Grid31.TextMatrix(ID, 7)), 5, 2) & "-" & Right(Trim(Grid31.TextMatrix(ID, 7)), 2) & "', "   ' Data Operação
  SQL = SQL & Replace(Grid31.TextMatrix(ID, 8), ",", ".") & ", '"  ' Montante
  SQL = SQL & Trim(Grid31.TextMatrix(ID, 9)) & "', '"              ' Divisa
  If Grid31.TextMatrix(ID, 10) = "" Then
    SQL = SQL & Grid31.TextMatrix(ID, 10) & "0, '"                 ' NUM XU
  Else
    SQL = SQL & Grid31.TextMatrix(ID, 10) & "', '"                 ' NUM XU
  End If
  SQL = SQL & Trim(Grid31.TextMatrix(ID, 11)) & "', '"             ' Chave Lancamento
  SQL = SQL & Trim(Grid31.TextMatrix(ID, 12)) & "', '"             ' Banco
  SQL = SQL & Trim(Grid31.TextMatrix(ID, 13)) & "', '"             ' Conta GL
  SQL = SQL & Trim(Grid31.TextMatrix(ID, 14)) & "', "       ' Conta ContraPartida A
  If Trim(Grid31.TextMatrix(ID, 15)) = "" Then
    SQL = SQL & "0 ,'"                                       ' Montante A
  Else
    SQL = SQL & Replace(Trim(Grid31.TextMatrix(ID, 15)), ",", ".") & ", '"   ' Montante A
  End If
  SQL = SQL & Trim(Grid31.TextMatrix(ID, 16)) & "', '"      ' Chave Lancamento A

  If Trim(Grid31.TextMatrix(ID, 18)) = "" Or Trim(Grid31.TextMatrix(ID, 18)) = 0 Then
  Else
    SQL = SQL & Trim(Grid31.TextMatrix(ID, 17)) & "', "     ' Conta ContraPartida B
    SQL = SQL & Replace(Trim(Grid31.TextMatrix(ID, 18)), ",", ".") & ", '"   ' Montante B
    SQL = SQL & Trim(Grid31.TextMatrix(ID, 19)) & "', '"    ' Tipo Conta B
  End If

  If Trim(Grid31.TextMatrix(ID, 20)) = "" Then
    SQL = SQL & "', '"                                      ' Status SAP

      SQL = SQL & " order by Contab.dtvalor desc"
    Else
      If Check8 = 1 Then
        SQL = SQL & ""
      Else
        SQL = SQL & " order by ContabREG.bookdate desc"
      End If
    End If
    
  Case "5"
    If Check3 = 1 Or Check4 = 1 Then
      SQL = SQL & " order by Contab.dsc desc"
    Else
      If Check8 = 1 Then
        SQL = SQL & ""
      Else
        SQL = SQL & " order by ContabREG.descricao desc"
      End If
    End If
  
  Case "6"
    If Check3 = 1 Or Check4 = 1 Then
      SQL = SQL & " order by Contab.dtoper desc"
    Else
      If Check8 = 1 Then
        SQL = SQL & ""
      Else
        SQL = SQL & " order by ContabREG.datamov desc"
      End If
    End If
  
  Case "8"
    If Check3 = 1 Or Check4 = 1 Then
      SQL = SQL & " order by Contab.cnt desc"
    Else
      If Check8 = 1 Then
        SQL = SQL & ""
      Else
        SQL = SQL & " order by ContabREG.conta desc"
      End If
    End If
  
  Case "9"
    If Check3 = 1 Or Check4 = 1 Then
      SQL = SQL & " order by Contab.mnt desc"
    Else
      If Check8 = 1 Then
        SQL = SQL & ""
      Else
        SQL = SQL & " order by ContabREG.montante desc"
      End If
    End If
  
  Case "11"
    If Check3 = 1 Or Check4 = 1 Then
      SQL = SQL & " order by Contab.divsa desc"
    Else
      If Check8 = 1 Then
        SQL = SQL & ""
      Else
        SQL = SQL & " order by ContabREG.divisa desc"
      End If
    End If
  
  Case "15"
    If Check3 = 1 Or Check4 = 1 Then

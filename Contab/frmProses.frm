Function DownString(ByVal Frase As String) As String
Dim Txt As String
Dim LtrCod, NuR As Integer

Txt = ""
For NuR = 1 To Len(Frase)
  LtrCod = Asc(Mid(Frase, NuR, 1))
  
  If LtrCod > 40 And LtrCod < 91 Then
    LtrCod = LtrCod + 32
  End If
  
  Txt = Txt & Chr(LtrCod)
Next

DownString = Txt

End Function

Function UpperString(ByVal Frase As String) As String
Dim Txt As String
Dim LtrCod, NuR As Integer

Txt = ""
For NuR = 1 To Len(Frase)
  LtrCod = Asc(Mid(Frase, NuR, 1))
  
  If LtrCod > 96 And LtrCod < 123 Then
    LtrCod = LtrCod - 32
  End If
  
  Txt = Txt & Chr(LtrCod)
Next

UpperString = Txt

End Function

Function Encrypt(ByVal icText As String) As String
 Dim icLen, I As Integer
 Dim icNewText, icChar As String
 icChar = ""
    icLen = Len(icText)
    For I = 1 To icLen
        icChar = Mid(icText, I, 1)
        Select Case Asc(icChar)
            Case 65 To 90
                icChar = Chr(Asc(icChar) + 127)
            Case 97 To 122
                icChar = Chr(Asc(icChar) + 121)
            Case 48 To 57
                icChar = Chr(Asc(icChar) + 196)
            Case 32
                icChar = Chr(32)
        End Select
        icNewText = icNewText + icChar
    Next
    Encrypt = icNewText
End Function

Function Decrypt(ByVal icText As String) As String
 Dim icLen, I As Integer
 Dim icNewText, icChar As String
 icChar = ""
    icLen = Len(icText)
    For I = 1 To icLen
        icChar = Mid(icText, I, 1)
        Select Case Asc(icChar)
            Case 192 To 217
                icChar = Chr(Asc(icChar) - 127)
            Case 218 To 243
                icChar = Chr(Asc(icChar) - 121)
            Case 244 To 253
                icChar = Chr(Asc(icChar) - 196)
            Case 32
                icChar = Chr(32)
        End Select
        icNewText = icNewText + icChar
    Next
    Decrypt = icNewText
End Function

Function TrataMontante(ByVal Nchar As Integer, Caracter As String) As String
Dim UltCHR, MonTmp, Txt As String

Select Case Nchar
Case 1
  UltCHR = Right(Caracter, 1)
  Select Case UltCHR
    Case "{", "é"
      Txt = "+0"
    Case "A"
      Txt = "+1"
    Case "B"
      Txt = "+2"
    Case "C"
      Txt = "+3"
    Case "D"
      Txt = "+4"
    Case "E"
      Txt = "+5"
    Case "F"
      Txt = "+6"
    Case "G"
      Txt = "+7"
    Case "H"
      Txt = "+8"
    Case "I"
      Txt = "+9"
    Case "}", "e", "è"
      Txt = "-0"
    Case "J"
      Txt = "-1"
    Case "K"
      Txt = "-2"
    Case "L"
      Txt = "-3"
    Case "M"
      Txt = "-4"
    Case "N"
      Txt = "-5"
    Case "O"
      Txt = "-6"
    Case "P"
      Txt = "-7"
    Case "Q"
      Txt = "-8"
    Case "R"
      Txt = "-9"
  End Select

  MonTmp = Left(Txt, 1) & Left(Caracter, Len(Caracter) - 1) & Right(Txt, 1)
'  MonTmp = Left(MonTmp, Len(MonTmp) - 2) & "." & Right(MonTmp, 2)
  
Case 2

End Select

TrataMontante = MonTmp

End Function


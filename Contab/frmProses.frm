Function CampoZU(ByVal cmpZU As String, ByVal tblZU As String, ByVal socZU As String) As String
Dim ZUtmp As String

ZUtmp = ""
SQL = "SELECT isnull(zu_column_name,'') AS ZU from zu_table_list where ZU_CODE='" & cmpZU & "' AND TABLE_NAME='" & tblZU & "'"
rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
ZUtmp = Trim(rs!ZU)
rs.Close
If ZUtmp <> "" Then
  SQL = "SELECT ISNULL(" & ZUtmp & ",'') AS ZUxx from companies where cmp_code='" & Trim(socZU) & "'"
  rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
  ZUtmp = Trim(rs!ZUxx)
  rs.Close
End If

CampoZU = ZUtmp

End Function


Function CreateLgDB(ByVal CmdS As String) As String
On Error GoTo errHandler
Dim Argt1, Argt2, Argt3, Argt4, Argt5, Argt6, Argt7 As String
Dim Nlg, N1, Ni, NrG As Integer

N1 = 0

For Nlg = 1 To Len(CmdS)
  If Mid(CmdS, Nlg, 1) = "'" Then
    N1 = N1 + 1
    
    Select Case N1
    Case 1
      Ni = Nlg + 1
    Case 2
      Argt1 = Mid(CmdS, Ni, Nlg - Ni)
    Case 3
      Ni = Nlg + 1
    Case 4
      Argt2 = Mid(CmdS, Ni, Nlg - Ni)
    Case 5
      Ni = Nlg + 1
    Case 6
      Argt3 = Mid(CmdS, Ni, Nlg - Ni)
    Case 7
      Ni = Nlg + 1
    Case 8
      Argt4 = Mid(CmdS, Ni, Nlg - Ni)
    Case 9
      Ni = Nlg + 1
    Case 10
      Argt5 = Mid(CmdS, Ni, Nlg - Ni)
    Case 11
      Ni = Nlg + 1
    Case 12
      Argt6 = Mid(CmdS, Ni, Nlg - Ni)
    Case 13
       Ni = Nlg + 1
    Case 14
      Argt7 = Mid(CmdS, Ni, Nlg - Ni)
    End Select
         
  End If
Next

SQL = "SELECT COUNT(contabref) AS NREG FROM contablingua WHERE contabref='" & Argt1 & "' AND contabseq=" & Argt2 & ""
rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
NrG = rs!NREG
rs.Close
  
If NrG = 0 Then
  CreateLgDB = "NEW"
  SQL = CmdS
  rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
Else
  SQL = "SELECT isnull(versao,'1') AS NREG FROM contablingua WHERE contabref='" & Argt1 & "' AND contabseq=" & Argt2
  rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
  NrG = rs!NREG
  rs.Close
  
  If NrG = Argt7 Then
    CreateLgDB = ""
  Else
    CreateLgDB = "UPDATE"
    SQL = "UPDATE contablingua SET PT='" & Argt3 & "', ES='" & Argt4 & "', EN='" & Argt5 & "', VERSAO='" & Argt7 & "' WHERE contabref='" & Argt1 & "' AND contabseq=" & Argt2
    rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
  End If
    
End If

GoTo fim

errHandler:
  txt_SQLLog ("[INSERT CreateLgDB]" & SQL)

fim:

End Function




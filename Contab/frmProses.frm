Function XUCodBanco(XUConta As String) As String
On Error GoTo errHandler
Dim NR, Tpo As Integer

Tpo = 0

SQL = "select count(acc_code) as NREG From ba_number_items_acc where baf_item_type='3' and electronic_value='" & Trim(XUConta) & "'"
rstmp.Open SQL, conn, adOpenDynamic, adLockOptimistic
NR = rstmp!NREG
rstmp.Close

If NR = 0 Then
  SQL = "select count(acc_code) as NREG From ba_number_items_acc where electronic_value='" & Trim(XUConta) & "'"
  rstmp.Open SQL, conn, adOpenDynamic, adLockOptimistic
  NR = rstmp!NREG
  rstmp.Close
  
  If NR = 0 Then
    Tpo = 0
  Else
    Tpo = 2
  End If
  
Else
  Tpo = 1
End If

If NR > 0 Then
  
  If Tpo = 1 Then
    SQL = "select left(electronic_value,40) as NIB ,acc_code as ACC_CODE,(select top 1 bank_code From accounts where accounts.acc_code=ba_number_items_acc.acc_code ) as BANCO From ba_number_items_acc where baf_item_type='3' and electronic_value='" & Trim(XUConta) & "'"
  Else
    SQL = "select Top 1 left(electronic_value,40) as NIB ,acc_code as ACC_CODE,(select top 1 bank_code From accounts where accounts.acc_code=ba_number_items_acc.acc_code ) as BANCO From ba_number_items_acc where electronic_value='" & Trim(XUConta) & "'"
  End If
  rstmp.Open SQL, conn, adOpenDynamic, adLockOptimistic
  
  If IsNull(rstmp!Banco) Or rstmp!Banco = "" Then
    XUCodBanco = ""
  Else
    XUCodBanco = Trim(rstmp!Banco)
  End If
  
  rstmp.Close

Else

  SQL = "select top 1 hkont,acc_code, ( select top 1 bank_code From accounts where accounts.acc_code=CONTAB_EXCEPCOES_ESPEC.acc_code ) as BANCO from CONTAB_EXCEPCOES_ESPEC where hkont='" & Trim(XUConta) & "'"
  rstmp.Open SQL, conn, adOpenDynamic, adLockOptimistic
  
  If IsNull(rstmp!Banco) Or rstmp!Banco = "" Then
    XUCodBanco = ""
  Else
    XUCodBanco = Trim(rstmp!Banco)
  End If
  
  rstmp.Close

End If


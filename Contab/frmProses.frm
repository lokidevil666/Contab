Function DevBDData(ByVal XUid As String, XuCmp As String, SQLtipo As Integer) As String
On Error GoTo errHandler
Dim XID, Xtp, Xcp1, Xcp2, TxtDev As String
Dim Xin1, Yin1, Xin2, Yin2, NREG As Integer


If Left(XUid, 1) <> "E" Then

  If SQLtipo = 1 Then
  
    XID = Right(XUid, Len(XUid) - 1)
    Xtp = Left(XUid, 1)
    Xcp1 = ""
    Xcp2 = ""
    TxtDev = ""
    
    If Len(Trim(XuCmp)) > 11 Then
      Xcp1 = DevBDCmp(Left(XuCmp, 4))
      Xcp2 = DevBDCmp(Mid(XuCmp, 11, 4))
      Xin1 = Mid(XuCmp, 5, 2)
      Xin2 = Mid(XuCmp, 15, 2)
      If Xin1 = 0 Then
        Xin1 = 1
      End If
      Yin1 = Mid(XuCmp, 8, 2)
      Yin2 = Mid(XuCmp, 18, 2)
    Else
      Xcp1 = DevBDCmp(Left(XuCmp, 4))
      Xcp2 = ""
      
      If Len(XuCmp) < 6 Then
        Xin1 = 0
      Else
        Xin1 = 1 * Mid(XuCmp, 5, 2)
      End If
      Xin2 = 0
      
      If Xin1 = 0 Then
        Xin1 = 1
      End If
      
      If Len(XuCmp) < 6 Then
        Yin1 = 30
      Else
        Yin1 = 1 * Mid(XuCmp, 8, 2)
      End If
      Yin2 = 0
      
    End If
    
    
    If Xcp1 <> "" Then
    
      If Check5 = 1 Then
        If Xcp1 = "ACC_CODE" Then
          SQL1 = "SELECT TOP 1 CASH_LEDGER_ID, DESCRIPTION AS CPBDA1 FROM CASH_LEDGER WHERE CASH_LEDGER_ID = " & XID
        Else
          If Xcp2 = "" Then
            SQL1 = "SELECT TOP 1 CASH_LEDGER_ID, " & Xcp1 & " AS CPBDA1 FROM CASH_LEDGER WHERE CASH_LEDGER_ID = " & XID
          Else
            SQL1 = "SELECT TOP 1 CASH_LEDGER_ID, " & Xcp1 & " AS CPBDA1, " & Xcp2 & " AS CPBDA2 FROM CASH_LEDGER WHERE CASH_LEDGER_ID = " & XID
          End If
        End If
      Else
        If Xtp = "N" Then
          If Xcp1 = "ACC_CODE" Then
            SQL1 = "SELECT TOP 1 NREC_BANK_MVT_ID, DESCRIPTION AS CPBDA1 FROM NREC_BANK WHERE NREC_BANK_MVT_ID = " & XID
          Else
            If Xcp2 = "" Then
              SQL1 = "SELECT TOP 1 NREC_BANK_MVT_ID, ISNULL(" & Xcp1 & ",'') AS CPBDA1 FROM NREC_BANK WHERE NREC_BANK_MVT_ID = " & XID
            Else
              SQL1 = "SELECT TOP 1 NREC_BANK_MVT_ID, " & Xcp1 & " AS CPBDA1, " & Xcp2 & " AS CPBDA2 FROM NREC_BANK WHERE NREC_BANK_MVT_ID = " & XID
            End If
          End If
        Else
          If Xcp1 = "ACC_CODE" Then
            SQL1 = "SELECT TOP 1 REC_BANK_MVT_ID, DESCRIPTION AS CPBDA1 FROM REC_BANK WHERE NREC_BANK_MVT_ID = " & XID
          Else
            If Xcp2 = "" Then
              SQL1 = "SELECT TOP 1 REC_BANK_MVT_ID, ISNULL(" & Xcp1 & ",'') AS CPBDA1 FROM REC_BANK WHERE REC_BANK_MVT_ID = " & XID
            Else
              SQL1 = "SELECT TOP 1 REC_BANK_MVT_ID, " & Xcp1 & " AS CPBDA1, " & Xcp2 & " AS CPBDA2 FROM REC_BANK WHERE REC_BANK_MVT_ID = " & XID
            End If
          End If
        End If
      End If
      rstmp.Open SQL1, conn, adOpenDynamic, adLockOptimistic
      
      If IsNull(rstmp!CPBDA1) Then
        TxtDev = ""
      Else
        If (Xin1 = "" Or Yin1 = "") Then
          TxtDev = Trim(rstmp!CPBDA1)
        Else
          TxtDev = Mid(Trim(rstmp!CPBDA1), Xin1, Yin1)
        End If
      End If
      
      If Xcp2 <> "" Then
        If IsNull(rstmp!CPBDA2) Then
          TxtDev = TxtDev
        Else
          TxtDev = TxtDev & Mid(Trim(rstmp!CPBDA2), Xin2, Yin2)
        End If
      Else
      End If
      
      rstmp.Close
      
      If Xcp1 = "ACC_CODE" Then
        NREG = 0
        SQL1 = "SELECT count(ACC_CODE) AS NR FROM ACCOUNTS WHERE ACC_CODE= '" & TxtDev & "'"
        rstmp.Open SQL1, conn, adOpenDynamic, adLockOptimistic
        NREG = rstmp!NR
        rstmp.Close
        
        If NREG <> 0 Then
          SQL1 = "SELECT TOP 1 ACC_CODE AS GLCODE FROM ACCOUNTS WHERE ACC_CODE= '" & TxtDev & "'"
          rstmp.Open SQL1, conn, adOpenDynamic, adLockOptimistic
          TxtDev = Mid(rstmp!glcode, Xin1, Yin1)
          rstmp.Close
        Else
          TxtDev = Mid("000000000000000", Xin1, Yin1)
        End If
        
      End If
    
    End If
    
    DevBDData = TxtDev
  
  Else
  
    If SQLtipo > 15 Then
      SQL1 = "SELECT TOP 1 " & XuCmp & " AS CPBD1 FROM CONTAB_EXCEPCOES_ESPEC WHERE CASH_LEDGER_ID=" & XUid & " and ordem=" & SQLtipo - 15
    Else
      SQL1 = "SELECT TOP 1 " & XuCmp & " AS CPBD1 FROM CONTAB_EXCEPCOES WHERE CASH_LEDGER_ID=" & XUid & " and ordem=" & SQLtipo - 10
    End If
    
    rstmp.Open SQL1, conn, adOpenDynamic, adLockOptimistic
    
    If IsNull(rstmp!CPBD1) Then
      TxtDev = ""
    Else
      TxtDev = Trim(rstmp!CPBD1)
    End If
    rstmp.Close
  
    If XuCmp = "VALUT" Or XuCmp = "BUDAT" Then
      DevBDData = Left(TxtDev, 10)
    Else
      DevBDData = TxtDev
    End If

  End If
  
Else

  DevBDData = ""

End If

GoTo fim

errHandler:
txt_LOG ("Comando SQL......[" & SQL & "]")
txt_LOG ("Comando SQL Aux..[" & SQL1 & "]")
txt_LOG ("DevBDData ...XUid[" & XUid & "]  XuCmp[" & XuCmp & "]")
  
fim:


End Function


Function CheckAdmin(flFileName As String, Optional FileNumber As Integer = 2, Optional msgMessageError As String = "File do not exist!!!", Optional msgStyleError As VbMsgBoxStyle = vbOKOnly + vbCritical, Optional msgTitleError As String = "Erro!! Ficheiro não existe!!!") As String
On Error GoTo msgError
Dim RowLine, Nx, Ny, Nw, NREG As Integer
Dim RowValue As String
Dim NewLine, TxToChk As String
  
  NewLine = Chr$(13) & Chr$(10)
  CheckAdmin = "NOFILE"
  If Dir(flFileName, vbNormal) = "" Then
    MsgBox msgMessageError, msgStyleError, msgTitleError
    Exit Function
  End If
  Nw = 1
  
  
  If Left(flFileName, 7) = "NATWEST" Or Left(flFileName, 6) = "NATWES" Or Left(flFileName, 5) = "NATWE" Or UpperString(Left(flFileName, 4)) = "NATW" Or Left(flFileName, 3) = "NAT" Or UpperString(Right(flFileName, 3)) = "CSV" Then
    If UpperString(Right(flFileName, 3)) = "CSV" Then
      CheckAdmin = "PAYPAL"
    Else
      CheckAdmin = "NATWEST"
    End If
  Else
    Open flFileName For Input As #FileNumber
    For RowLine = 0 To LOF(FileNumber)
      Line Input #FileNumber, RowValue
      If EOF(FileNumber) Or CheckAdmin <> "NOFILE" Or Nw = 10 Then
        Exit For
        Exit Function
      End If
    
      For Ny = 1 To 30
        For Nx = 1 To 18
      
          If CheckAdmin <> "NOFILE" Then
            Exit For
          End If
    
          TxToChk = Mid(RowValue, Ny, 20 - Nx)
          NREG = 0
          SQL = "select count(tipo) as QTReg from ContabADMIN_TipoCNT where conta like ('" & TxToChk & "')"
          rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
          NREG = rs!qtreg
          rs.Close
        
          If NREG <> 0 Then
            SQL = "select TOP 1 tipo as TipoReg from ContabADMIN_TipoCNT where conta like ('" & TxToChk & "')"
            rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
            CheckAdmin = Trim(rs!tiporeg)
            rs.Close
          End If
        
        Next 'For Nx
            
        If CheckAdmin <> "NOFILE" Then
          Exit For
        End If

      Next 'For Ny
    
      Nw = Nw + 1
    
    Next RowLine
    Close 'FileNumber
    
  End If ' If do Natwest
  
  If CheckAdmin = "NOFILE" Then
    If OpLG Then
      MsgBox LGBox(16)   ' MSGBOX 16
    Else
      MsgBox "Não foi possivel encontrar a origem do ficheiro."   ' MSGBOX 16
    End If
  End If
  
  Exit Function

msgError:
  If OpLG Then
    MsgBox LGBox(17) & " " & flFileName & ".", vbExclamation + vbOKOnly, LGBox(18)  ' MSGBOX 17 e 18
  Else
    MsgBox "Verificou-se um erro ao abrir o ficheiro """ & flFileName & """.", vbExclamation + vbOKOnly, "Erro"  ' MSGBOX 17 e 18
  End If
End Function


Sub TXTExportSAPR()
On Error GoTo errHandler
Dim fso As New FileSystemObject, ts As TextStream
Dim CFile, CTxt, Cmnt, Banco, BnkUso As String
Dim SAPcc, CCUSTO, CntCustoA, CntCustoB, MntReg, MntRegCVa, MntRegCVb As String
Dim X, NR, CCnt As Integer

CFile = PathSaida & "Items" & Combo9 & ".txt"

If fso.FileExists(CFile) = True Then
'  fso.DeleteFile (CFile)
  Set ts = fso.OpenTextFile(CFile, ForAppending)
Else
  Set ts = fso.CreateTextFile(CFile, True)
End If

For X = 1 To Grid31.Rows - 2

  If Trim(Grid31.TextMatrix(X, 4)) <> "NC" Then
    
'    SQL = "SELECT count(ccusto) as NREG FROM regra WHERE bnkconta='" & Trim(Grid31.TextMatrix(X, 1)) & "' and bnkdesc like '%" & Trim(Grid31.TextMatrix(X, 3)) & "%'"
'    rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
'    SAPcc = rs!NReg
'    rs.Close
'
'    If SAPcc > 0 Then
'      SQL = "SELECT TOP 1 ccusto FROM regra WHERE bnkconta='" & Trim(Grid31.TextMatrix(X, 1)) & "' and bnkdesc like '%" & Trim(Grid31.TextMatrix(X, 3)) & "%'"
'      rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
'      CCUSTO = Trim(rs!CCUSTO)
'      rs.Close
'    Else
'    End If

    SQL = "SELECT count(CentroCusto) as NREG FROM centrocusto WHERE empresa = '" & Trim(Grid31.TextMatrix(X, 0)) & "'"
    rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
    NR = rs!NREG
    rs.Close

    If NR > 0 Then
      If (SAPcc = 0 Or CCUSTO = "") Then
        SQL = "SELECT CentroCusto FROM centrocusto WHERE empresa = '" & Trim(Grid31.TextMatrix(X, 0)) & "'"
        rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
        CCUSTO = "       "
        rs.Close
      End If

    Else
      SQL = "INSERT INTO centrocusto (empresa, centrocusto) VALUES ( '" & Trim(Grid31.TextMatrix(X, 0)) & "', '')"
      rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
    End If
   
' Movimento Bancario
    MntReg = Abs(Grid31.TextMatrix(X, 8))
    If Len(Trim(Grid31.TextMatrix(X, 15))) <> 0 Then
      MntRegCVa = Abs(Round(Grid31.TextMatrix(X, 15), 2))
    End If
    If Len(Trim(Grid31.TextMatrix(X, 18))) <> 0 Then
      MntRegCVb = Abs(Round(Grid31.TextMatrix(X, 18), 2))
    End If
    
    If Left(Right(MntReg, 3), 1) = "." Or Left(Right(MntReg, 3), 1) = "," Then
      MntReg = MntReg
    Else
      If Left(Right(MntReg, 2), 1) = "." Or Left(Right(MntReg, 2), 1) = "," Then
        MntReg = MntReg & "0"
      Else
        MntReg = MntReg & ".00"
      End If
    End If
    MntReg = Replace(MntReg, ".", SepDec)
    
    If Left(Right(MntRegCVa, 3), 1) = "." Or Left(Right(MntRegCVa, 3), 1) = "," Then
      MntRegCVa = MntRegCVa
    Else
      If Left(Right(MntRegCVa, 2), 1) = "." Or Left(Right(MntRegCVa, 2), 1) = "," Then
        MntRegCVa = MntRegCVa & "0"
      Else
        MntRegCVa = MntRegCVa & ".00"
      End If
    End If
    MntRegCVa = Replace(MntRegCVa, ".", SepDec)
    
    If Left(Right(MntRegCVb, 3), 1) = "." Or Left(Right(MntRegCVb, 3), 1) = "," Then
      MntRegCVb = MntRegCVb
    Else
      If Left(Right(MntRegCVb, 2), 1) = "." Or Left(Right(MntRegCVb, 2), 1) = "," Then
        MntRegCVb = MntRegCVb & "0"
      Else
        MntRegCVb = MntRegCVb & ".00"
      End If
    End If
    MntRegCVb = Replace(MntRegCVb, ".", SepDec)
    
    SQL = "select ccustoa, ccustob,centrocusto from fluxogl where fluxogl='" & Trim(Grid31.TextMatrix(X, 4)) & "'"
    rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
    If IsNull(rs!ccustoa) Or rs!ccustoa = "" Then
      CntCustoA = ""
    Else
      CntCustoA = Trim(rs!ccustoa)
    End If
    If IsNull(rs!ccustob) Or rs!ccustob = "" Then
      CntCustoB = ""
    Else
      CntCustoB = Trim(rs!ccustob)
    End If
    rs.Close
    
    CTxt = Left(Trim(Grid31.TextMatrix(X, 13)) & "            ", 10) & Right("        " & CCUSTO, 8) & Right("                    " & MntReg, 15) & "  "
    CTxt = CTxt & Right("0" & Grid31.TextMatrix(X, 11), 2) & Left(Grid31.TextMatrix(X, 3) & "                                                 ", 50)
    CTxt = CTxt & Grid31.TextMatrix(X, 7) & "                     0.00"
    ts.WriteLine CTxt
    
    CTxt = Left(Trim(Grid31.TextMatrix(X, 14)) & "            ", 10) & Right("        " & CntCustoA, 8) & Right("                    " & MntRegCVa, 15) & "  "
    CTxt = CTxt & Right("0" & Grid31.TextMatrix(X, 16), 2) & Left(Grid31.TextMatrix(X, 3) & "                                                 ", 50)
    CTxt = CTxt & Grid31.TextMatrix(X, 7) & "                     0.00"
    ts.WriteLine CTxt
    
    If Len(Trim(Grid31.TextMatrix(X, 18))) <> 0 Then
      CTxt = Left(Trim(Grid31.TextMatrix(X, 17)) & "            ", 10) & Right("        " & CntCustoB, 8) & Right("                    " & MntRegCVb, 15) & "  "
      CTxt = CTxt & Right("0" & Grid31.TextMatrix(X, 19), 2) & Left(Grid31.TextMatrix(X, 3) & "                                                 ", 50)
      CTxt = CTxt & Grid31.TextMatrix(X, 7) & "                     0.00"
      ts.WriteLine CTxt
    End If
    
    
  End If
    
    
  If Check7 = 1 Then
  
    MarcaBDviaTXT (X)
    
  End If

Next
ts.Close

If OpLG Then
  MsgBox LGBox(71), vbOKOnly       'MSGBOX 71
Else
  MsgBox "(SAP R) Exportação Concluida!!", vbOKOnly       'MSGBOX 71
End If

GoTo fim

errHandler:
  MsgBox "SQL: " & SQL & " - " & Grid31.TextMatrix(X, 3)    'MSGBOX 72
  
fim:

End Sub


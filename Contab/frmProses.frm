Function PutMovTbl(ByVal FRPid As String, ByVal RgrId As Long, ByVal FlxId As Long) As String
On Error GoTo errHandler
Dim LcL As String
Dim NR As Integer

LcL = "PMT1001"
SQL = "SELECT COUNT(FRPID) AS NREG FROM CONTAB_REGRA WHERE FRPID=" & Right(FRPid, Len(FRPid) - 1)
rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
NR = rs!NREG
rs.Close

If NR = 0 Then
  LcL = "PMT1002"
  SQL = "INSERT INTO CONTAB_REGRA (FRPID,FLUXOID,REGRAID,OBS) VALUES(" & Right(FRPid, Len(FRPid) - 1) & "," & FlxId & "," & RgrId & ",'')"
  rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
  PutMovTbl = "Insert"
Else
  LcL = "PMT1003"

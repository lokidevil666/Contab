        'SQL = "update confg set valor='" & Text11 & "' where campo='SQL' and UTILIZADOR='" & Text17 & "'"
        'rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
        
      End If
      
      If Reboot Then
        If OpLG Then
          Yy = MsgBox(LGBox(95), vbYesNo)      'MSGBOX 95
        Else
          Yy = MsgBox("É necessário reinicializar o programa.", vbYesNo)      'MSGBOX 95
        End If
        Select Case Yy
        Case 6
          Fecha_BD
          End
  
        Case 7
          If OpLG Then
            MsgBox (LGBox(96)), vbOKOnly     'MSGBOX 96
          Else
            MsgBox ("As alterações só terão efeito após reinicializar o programa."), vbOKOnly     'MSGBOX 96
           End If
        End Select
      Else
      End If
        
    Case 7
      Text3 = SQLServer
      Text4 = SQLDBase
      Text5 = SQLUser
      Text6 = SQLPass
      Text7(2) = SAPUser
      Text7(3) = SAPPass

    End Select   'Case 1
  End If
  
  Frame1.Visible = False
  LGCase(0) = "CONTAB"

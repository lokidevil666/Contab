Function EscreveLOG(ByVal Tp As Integer, ByVal Tx As String) As String
'   Tipo  Descrição
'   1     Inicio / Fim Processos
'   2     Configuração
'   3     Informação diversa
'   4     Update / Insert de informação em Tabelas
'   9     ERROS

If DBOpen Then
  SQL = "INSERT INTO CONTABLOG (TIPO, EVENTO, DATA, PROCESSO) VALUES (" & Tp & ", '" & Left(Tx, 99) & "', getdate(), " & OP & ")"
  rs.Open SQL, conn, adOpenDynamic, adLockOptimistic
End If
EscreveLOG = "ok"

End Function


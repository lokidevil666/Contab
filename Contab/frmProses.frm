  If Text2 = "Fim" Then
    Calendar1.Visible = False
    Text2 = ""
  Else
    Calendar1.Visible = True
    Text2 = "Fim"
  End If
  
Case "Estado Contabilização"
  If Text2 = "Fim" Then
    Calendar1.Visible = False
    Text2 = ""
  Else
    Calendar1.Visible = True
    Text2 = "Fim"
  End If
  
Case "Contabilização"
  
  If LGCase(5) = "Marcar Registos" Then
  
    If OpLG Then
      If Text2 = LGEstado(11) Then
        Calendar1.Visible = False
        Text2 = ""
      Else
        Calendar1.Visible = True
        Text2 = LGEstado(11)
      End If
    Else
      If Text2 = "Fim" Then
        Calendar1.Visible = False
        Text2 = ""
      Else
        Calendar1.Visible = True
        Text2 = "Fim"
      End If
    End If
  
  Else
  
    If LGCase(3) = "Data" And (Left(Text1, 2) = "20") And (Text2 = "") Then
      
      If OpLG Then
        If Text2 = LGEstado(11) Then
          Calendar1.Visible = False
          Text2 = ""
        Else
          Calendar1.Visible = True
          Text2 = LGEstado(11)
        End If
      Else
        If Text2 = "Fim" Then
          Calendar1.Visible = False
          Text2 = ""
        Else
          Calendar1.Visible = True
          Text2 = "Fim"
        End If
      End If
    
    Else
      
      If OpLG Then
        StatusBar1.Panels.Item(2).Text = LGStatus(6)
      Else
        StatusBar1.Panels.Item(2).Text = "Por favor Aguarde - PROCESSAMENTO em Curso"
      End If
      
      If Text1 = "" And Text2 = "" Then
        RES = OpenSTRBD(0, 0, 0)
        ResR = OpenSTRBDRec(0, 0, 0)
      Else
        If Text1 <> "" And Text2 = "" Then
          RES = OpenSTRBD(0, Text1, 0)
          ResR = OpenSTRBDRec(0, Text1, 0)
        Else
          If Text1 = "" And Text2 <> "" Then
            RES = OpenSTRBD(0, 0, Text2)
            ResR = OpenSTRBDRec(0, 0, Text2)
          Else
            If LGCase(3) <> "Data" Then
              NT1 = Val(Right(Text1, Len(Text1) - 1))
              NT2 = Val(Right(Text2, Len(Text2) - 1))
            Else
              NT1 = Text1
              If Text2 = "Fim" Then
                NT2 = 0
              Else
                NT2 = Text2
              End If
              Calendar1.Visible = False
            End If
            RES = OpenSTRBD(0, NT1, NT2)
            ResR = OpenSTRBDRec(0, NT1, NT2)
          End If
        End If
      End If
      Text1 = ""
      Text2 = ""
      StatusBar1.Panels.Item(2).Text = ""
  
    End If
  
  End If
  
Case "Administradoras"
  If Text2 = "Fim" Then
    Calendar1.Visible = False
    Text2 = ""
  Else
    Calendar1.Visible = True
    Text2 = "Fim"
  End If
  
End Select

End Sub


Function DVDATA(XDt As String) As String

If Trim(XDt) = "" Then
  DVDATA = ""
Else
  If Mid(XDt, 3, 1) = "-" Or Mid(XDt, 3, 1) = "/" Or Mid(XDt, 3, 1) = "." Then
    DVDATA = Right(XDt, 4) & Mid(XDt, 4, 2) & Left(XDt, 2)
  Else
    DVDATA = Left(XDt, 4) & Mid(XDt, 6, 2) & Right(XDt, 2)
  End If
End If

End Function


